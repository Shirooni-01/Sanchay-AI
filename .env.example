# ============================================================================
# Sanchay AI — Environment Configuration Template (.env.example)
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env` in the project root:
#      Copy-Item .env.example .env
# 2. Replace placeholder values with your local development credentials.
# 3. NEVER commit `.env` to version control.
# ============================================================================

# --- Application Environment ---
FLASK_APP=wsgi:app
FLASK_ENV=development
FLASK_DEBUG=1
APP_NAME="Sanchay AI"
APP_HOST=127.0.0.1
APP_PORT=5000

# --- Security & Session Configuration ---
# Generate a strong secret key via:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-64-char-hex-secret-key-generated-locally
WTF_CSRF_ENABLED=true
WTF_CSRF_TIME_LIMIT=3600
SESSION_COOKIE_NAME=sanchay_session
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
# Set SESSION_COOKIE_SECURE=true in HTTPS production environments
SESSION_COOKIE_SECURE=false
PERMANENT_SESSION_LIFETIME_MINUTES=480

# --- PostgreSQL Database Configuration (Single Source of Truth) ---
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg2://postgres:replace_with_local_db_password@localhost:5432/sanchay_ai_dev
TEST_DATABASE_URL=postgresql+psycopg2://postgres:replace_with_local_db_password@localhost:5432/sanchay_ai_test
SQLALCHEMY_ECHO=false
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_MAX_OVERFLOW=20

# --- Default Business Rule Thresholds (Configurable per Organization/Shop in DB) ---
DEFAULT_LOW_STOCK_THRESHOLD=10
DEFAULT_NEAR_EXPIRY_DAYS=15
DEFAULT_SURPLUS_COVERAGE_DAYS=30
TRANSFER_OFFER_EXPIRY_HOURS=24
TRANSFER_DISPATCH_SLA_HOURS=48
TRANSFER_RECEIPT_SLA_HOURS=72
MAX_TRANSFER_DISTANCE_KM=50.0
TRANSFER_COST_PER_KM_INR=8.00

# --- Pagination & Reporting Limits ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
EXPORT_MAX_ROWS=10000

# --- Logging Configuration ---
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/sanchay_ai.log

# --- Phase 8 ONLY: AI Inventory Intelligence Configuration ---
# Keep AI_ENABLED=false during Phases 1 through 7.
# Do NOT enable or wire AI modules until Phase 8 is explicitly approved.
AI_ENABLED=false
AI_MIN_HISTORY_DAYS=14
AI_FORECAST_HORIZON_DAYS=14
AI_MODEL_ARTIFACTS_DIR=models
